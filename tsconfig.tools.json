{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuild/tools.tsbuildinfo"
  },
  "include": ["vitest.config.ts", "scripts/**/*.ts"],
  "references": [{ "path": "packages/core" }, { "path": "packages/conformance" }]
}
