{
  "name": "tokenize-step-by-step",
  "version": "0.0.0",
  "private": true,
  "description": "Client-side step-by-step tokenization visualizer: text → code points → UTF-8 bytes → pre-tokenizer chunks → BPE merges → tokens.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26 <27"
  },
  "browserslist": [
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "chrome >= 109",
    "firefox >= 115"
  ],
  "scripts": {
    "dev": "pnpm --filter @tsbs/web dev",
    "vocab:fetch": "uv run --project tools/oracle tools/oracle/fetch_vocab.py",
    "vocab:build": "tsbs-vocab build",
    "vocab:verify": "tsbs-vocab verify",
    "generate": "node apps/web/plugins/generate.ts",
    "vocab:guard": "node scripts/check-dist.ts --vocab",
    "conformance:gate": "node scripts/check-conformance-gate.ts",
    "unicode:export": "uv run --project tools/oracle tools/oracle/export_unicode_tables.py && node scripts/unicode-tables.ts",
    "unicode:check": "node scripts/unicode-tables.ts --check",
    "registry:check": "node packages/registry/scripts/registry-check.ts && vitest run --project registry",
    "contrast:check": "pnpm --filter @tsbs/ui-tokens check",
    "test": "pnpm generate && vitest run && pnpm test:browser",
    "test:browser": "vitest run --config apps/web/vitest.browser.config.ts",
    "test:fuzz": "node packages/core/test/fuzz/cli.ts",
    "test:perf": "pnpm generate && vitest run --project core --project worker --no-file-parallelism -t TSBS_PERF",
    "bench": "vitest bench --run --config packages/core/test/bench/vitest.bench.config.ts --outputJson node_modules/.cache/tsbs/bench.json && node packages/core/test/bench/check-bench.ts",
    "e2e": "pnpm --filter @tsbs/e2e e2e",
    "e2e:shell": "pnpm e2e shell",
    "e2e:headers": "pnpm --filter @tsbs/e2e e2e:headers",
    "e2e:perf": "pnpm --filter @tsbs/e2e exec playwright test --config perf/playwright.config.ts",
    "lint": "pnpm generate && eslint --max-warnings 0 .",
    "typecheck": "pnpm generate && tsc -b && pnpm --filter @tsbs/web svelte-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-config-hints",
    "build": "pnpm vocab:build && pnpm build:site",
    "build:site": "pnpm --filter @tsbs/web build && pnpm check:dist && pnpm exec wrangler deploy --dry-run",
    "check:dist": "node scripts/check-dist.ts && tsbs-vocab guard --dist apps/web/dist && size-limit --config size-limit.json --ignore-missing",
    "lhci": "pnpm dlx @lhci/cli@0.15.1 autorun --config=lighthouserc.json",
    "deploy": "wrangler deploy",
    "deploy:smoke": "node scripts/deploy-smoke.ts",
    "preview:pr": "node scripts/preview-pr.ts",
    "reverify": "node scripts/reverify.ts",
    "oracle:check": "uv run --project tools/oracle tools/oracle/fetch_vocab.py && uv run --project tools/oracle tools/oracle/make_corpus.py --check && uv run --project tools/oracle tools/oracle/gen_fixtures.py --check && uv run --project tools/oracle tools/oracle/render_license_docs.py --check && uv run --project tools/oracle tools/oracle/export_unicode_tables.py --check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@size-limit/file": "14.3.0",
    "@tsbs/conformance": "workspace:*",
    "@tsbs/core": "workspace:*",
    "@tsbs/vocab-tools": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "size-limit": "14.3.0",
    "svelte": "5.57.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
