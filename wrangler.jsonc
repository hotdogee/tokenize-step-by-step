{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokenize-step-by-step",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Production hostname (06 §5, docs/release.md): a Workers Custom Domain on the hanlin.uk zone of this account. CI's
  // `wrangler deploy` attaches it (DNS record + certificate), which needs the API token's Zone › Workers Routes › Edit,
  // Zone › DNS › Edit and Zone › Zone › Read on hanlin.uk. workers.dev stays on for the PR preview URLs.
  "routes": [{ "pattern": "tokens.hanlin.uk", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  // The `preview` job's `wrangler preview --name pr-<n>` (06 §3) needs this block, even empty; assets, compatibility
  // settings and routes stay at the top level.
  "previews": {}
}
