{
  "name": "@tsbs/vocab-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Node-only vocabulary converter CLI (tsbs-vocab): upstream files → TSBV1 assets + vocab manifest. Never bundled.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "tsbs-vocab": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./dev": "./src/dev/index.ts",
    "./vite-support": "./src/vite-support.ts"
  },
  "dependencies": {
    "@tsbs/conformance": "workspace:*",
    "@tsbs/core": "workspace:*"
  }
}
