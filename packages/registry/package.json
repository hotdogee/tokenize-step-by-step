{
  "name": "@tsbs/registry",
  "version": "0.0.0",
  "private": true,
  "description": "Registry data (tokenizers, models, licences, examples, BYOK, strings) with zod schemas and registry:check. zod is build/test only; the browser imports types and plain JSON.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./tokenizers": "./src/data/tokenizers.ts",
    "./models": "./src/data/models.ts",
    "./licences": "./src/data/licences.ts",
    "./examples": "./src/data/examples.ts",
    "./byok": "./src/data/byok.ts",
    "./strings": "./src/data/strings.ts",
    "./schema": "./src/schema.ts",
    "./check": "./src/check.ts",
    "./data/*.json": "./data/*.json"
  },
  "dependencies": {
    "@tsbs/core": "workspace:*",
    "zod": "4.6.7"
  }
}
